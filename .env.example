# Server Configuration
NODE_ENV=production
PORT=3000

# CORS Configuration
CORS_ORIGIN=*

# Email Configuration (Optional - for contact form)
EMAIL_ENABLED=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-password
EMAIL_FROM=noreply@zynthora.ai
EMAIL_TO=contact@zynthora.ai

# Application Settings
APP_NAME=Zynthora.ai
APP_URL=https://zynthora.ai
